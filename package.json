{
  "name": "khayal-warehouse-management",
  "productName": "KHAYAL Warehouse Management System",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron-dist/main.js",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist electron-dist release",
    "lint": "tsc --noEmit",
    "compile:electron": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --outdir=electron-dist --external:electron",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && npm run compile:electron && cross-env VITE_DEV_SERVER_URL=http://localhost:3000 electron electron-dist/main.js\"",
    "electron:build": "npm run build && npm run compile:electron",
    "dist": "npm run electron:build && electron-builder --win"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.17.1",
    "html2canvas": "^1.4.1",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wait-on": "^9.1.0"
  }
}
