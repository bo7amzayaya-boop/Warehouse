{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.khayal.warehouse",
  "productName": "KHAYAL Warehouse Management System",
  "copyright": "Copyright © 2026 KHAYAL",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron-dist/**/*",
    "package.json"
  ],
  "win": {
    "target": ["nsis"],
    "icon": "assets/icon.ico",
    "requestedExecutionLevel": "asInvoker"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "KHAYAL Warehouse Management System",
    "artifactName": "KHAYAL-Warehouse-Setup.exe"
  }
}
